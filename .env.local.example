# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# NEVER put real keys in THIS file — it is committed to a public repository.

# ---------------------------------------------------------------------------
# LIVE project — the one the app talks to, and the one holding real data.
# ---------------------------------------------------------------------------
# Browser-visible. Safe to expose: row-level security is the boundary, not this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server and tooling only. Bypasses every RLS policy.
# Never prefix with NEXT_PUBLIC_ — that compiles it into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by `supabase db push`.
SUPABASE_DB_PASSWORD=

# Supabase CLI auth (https://supabase.com/dashboard/account/tokens).
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# TEST project — a SEPARATE, EMPTY Supabase project.
# ---------------------------------------------------------------------------
# Database tests create and delete real auth users, and the Playwright suite
# drives the whole app. Both must run somewhere that holds nothing you care
# about. playwright.config.ts overrides NEXT_PUBLIC_* with these values, so the
# app under test cannot reach the live project even if .env.local says otherwise.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_DB_PASSWORD=
